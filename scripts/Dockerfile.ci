FROM alpine:3.16 AS builder
ARG THREADS="4"

# build dependencies (with BuildKit cache for apk)
WORKDIR /
RUN --mount=type=cache,target=/var/cache/apk \
    set -xe && \
    apk add --no-cache --virtual .build-tools git g++ build-base linux-headers cmake python3 && \
    apk add --no-cache --virtual .build-deps curl-dev rapidjson-dev pcre2-dev yaml-cpp-dev && \
    git clone https://github.com/ftk/quickjspp --depth=1 && \
    cd quickjspp && \
    git submodule update --init --depth=1 && \
    cmake -DCMAKE_BUILD_TYPE=Release . && \
    make quickjs -j $THREADS && \
    install -d /usr/lib/quickjs/ && \
    install -m644 quickjs/libquickjs.a /usr/lib/quickjs/ && \
    install -d /usr/include/quickjs/ && \
    install -m644 quickjs/quickjs.h quickjs/quickjs-libc.h /usr/include/quickjs/ && \
    install -m644 quickjspp.hpp /usr/include && \
    cd .. && \
    git clone https://github.com/PerMalmberg/libcron --depth=1 && \
    cd libcron && \
    git submodule update --init --depth=1 libcron/externals/date && \
    cmake -DCMAKE_BUILD_TYPE=Release . && \
    make libcron -j $THREADS && \
    install -m644 libcron/out/Release/liblibcron.a /usr/lib/ && \
    install -d /usr/include/libcron/ && \
    install -m644 libcron/include/libcron/* /usr/include/libcron/ && \
    install -d /usr/include/date/ && \
    install -m644 libcron/externals/date/include/date/* /usr/include/date/ && \
    cd .. && \
    git clone https://github.com/ToruNiina/toml11 --branch="v4.3.0" --depth=1 && \
    cd toml11 && \
    cmake -DCMAKE_CXX_STANDARD=11 . && \
    make install -j $THREADS

# build subconverter (with pip cache)
COPY . /subconverter/
WORKDIR /subconverter
# 注意：update_rules.py 会 git clone ACL4SSR 等规则仓库（scripts/rules_config.conf）
# 它依赖 GitHub 直连，Actions runner 上通常没问题；
# 若哪天失败，临时注释掉这一行即可用仓库里已提交的 rules 继续构建
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m ensurepip && \
    python3 -m pip install gitpython && \
    (python3 scripts/update_rules.py -c scripts/rules_config.conf || echo "WARN: rules update failed, using committed rules") && \
    cmake -DCMAKE_BUILD_TYPE=Release . && \
    make -j $THREADS

# build final image
FROM alpine:3.16

# tzdata 必须装，否则 /usr/share/zoneinfo/Asia/Shanghai 不存在，ln -sf 会创建死链
RUN apk add --no-cache --virtual subconverter-deps pcre2 libcurl yaml-cpp tzdata

COPY --from=builder /subconverter/subconverter /usr/bin/
COPY --from=builder /subconverter/base /base/

# 时区按需改；Docker 部署时也可用 environment: TZ=... 覆盖
ENV TZ=Asia/Shanghai
RUN ln -sf /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo $TZ > /etc/timezone

WORKDIR /base
# exec 形式：让 subconverter 成为 PID 1，docker stop 的 SIGTERM 能直接送达
CMD ["subconverter"]

EXPOSE 25500/tcp
